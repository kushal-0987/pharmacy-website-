# Two Brothers Healthcare Pvt. Ltd. - Environment Configuration Template
# Copy this file to .env or .env.local to configure external services.

# Application Base
VITE_APP_URL="http://localhost:3000"
VITE_APP_NAME="Two Brothers Healthcare Pvt. Ltd."
VITE_CLINIC_LOCATION="Sanagau, Lalitpur, Nepal"

# Supabase (PostgreSQL Database & Auth & Storage)
# Required when transitioning from the built-in reactive local store to remote Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# SMS Gateway (Nepal - Sparrow SMS / Aakash SMS)
# Used for instant OTP authentication, booking SMS alerts, and delivery updates
SPARROW_SMS_TOKEN="your-sparrow-sms-api-token"
SPARROW_SMS_FROM="TBHealth"

# Email Provider (Resend / SendGrid)
# Used for booking confirmations, lab report PDFs, and staff alerts
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Two Brothers Healthcare <no-reply@twobrotherscare.com.np>"

# Digital Payment Gateways (Nepal)
FONEPAY_MERCHANT_CODE="TBH_SANAGAU_001"
FONEPAY_SECRET_KEY="your-fonepay-secret-key"
ESEWA_MERCHANT_CODE="EPAYTEST"
KHALTI_PUBLIC_KEY="test_public_key_dc74e0fd57cb46cd93832aee0a507e4b"

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKey"
